# Copy to backend/.env and fill in. backend/.env is gitignored -- never commit it.
# Every variable here is read by backend/config.py. A missing required one makes
# the app (and alembic) fail loudly at import, which is deliberate.

# ---------------------------------------------------------------- database
# The +asyncpg driver is required -- the app uses an async engine.
# Host-run backend talking to the Postgres container:
DATABASE_URL=postgresql+asyncpg://finance:devpassword@localhost:5432/finance_tracker
# Backend running INSIDE a container (Stage 3+): the host becomes the compose
# service name, because "localhost" inside a container means that container.
# DATABASE_URL=postgresql+asyncpg://finance:devpassword@db:5432/finance_tracker

# TLS mode passed straight to asyncpg. "require" for Neon, blank for a local
# container (blank lets asyncpg default to "prefer", which works for both).
DB_SSL=

# Log every SQL statement. Useful while learning, noisy later.
DB_ECHO=true

# ---------------------------------------------------------------- auth: google
# Leave all three BLANK to disable Google sign-in completely. The backend then
# reports google_enabled=false from GET /api/auth/config and the frontend hides
# the button. Production credentials belong in production only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------- auth: general
# Must match the browser's address bar EXACTLY -- scheme, host, port, no
# trailing slash. CORS compares it as a plain string, and "localhost" and
# "127.0.0.1" are different origins.
FRONTEND_URL=http://127.0.0.1:5173

# Extra origins allowed to call this API. Lets `npm run dev` and the
# containerised frontend on :3000 both work without restarting the backend.
CORS_EXTRA_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-me
JWT_SECRET=replace-me

REFRESH_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=60

# false over plain http (local, and EC2 without TLS). true behind https.
COOKIE_SECURE=false
# "lax" works for localhost and for same-site hosts on different ports.
# Cross-SITE (a Vercel frontend calling a Render backend) needs "none" + COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Sign-in methods offered. Google additionally requires the three vars above.
AUTH_GOOGLE_ENABLED=true
AUTH_PASSWORD_ENABLED=true
