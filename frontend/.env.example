# Copy to frontend/.env. Gitignored -- never commit it.
#
# IMPORTANT: Vite substitutes VITE_* variables into the JavaScript bundle at
# BUILD time. They are not read when the container starts. A built frontend is
# therefore welded to whatever URL was set when `vite build` ran.
#
# Leave it BLANK and the app falls back to a relative "/api", which is what we
# want once nginx proxies /api to the backend -- then one build works in every
# environment.
VITE_API_URL=http://127.0.0.1:8000
