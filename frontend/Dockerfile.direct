# syntax=docker/dockerfile:1
# Design A: no nginx. The browser talks to the backend directly, so the API
# URL has to be compiled into the bundle.

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite substitutes VITE_* at BUILD time -- not at container start. ARG makes
# it a build-time input. Declared AFTER npm ci so changing the URL doesn't
# invalidate the dependency layer.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

EXPOSE 4173
# --host 0.0.0.0 for the same reason uvicorn needed it: vite preview binds
# loopback by default, which would be unreachable from outside the container
# even with -p.
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]
